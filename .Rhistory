count = sum(count, na.rm = T),
threshold = min(threshold)
), by =.(asc_allele)]
final_columns <- c("asc_allele", "count", "threshold", "z_score")
}
## add base counts
genotype_dt[is.na(count), count := base_count]
genotype_dt[, depth := sum(count)]
## get the z_score
genotype_dt[, z_score := z_score(count, depth, threshold)]
genotype_dt <- genotype_dt[, final_columns]
